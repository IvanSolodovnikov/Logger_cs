<Window x:Class="LogManagerApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogManagerApp.ViewModels"
        Title="Log Manager" Height="400" Width="600">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <StackPanel>
            <ListBox Height="250" ItemsSource="{Binding Messages}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Добавить Info" Width="120" Margin="5"
                        Click="AddInfo_Click"/>
                <Button Content="Добавить Warning" Width="120" Margin="5"
                        Click="AddWarning_Click"/>
                <Button Content="Добавить Error" Width="120" Margin="5"
                        Click="AddError_Click"/>
                <Button Content="Сохранить в файл" Width="120" Margin="5"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>