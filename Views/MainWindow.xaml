<Window x:Class="LogManagerApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogManagerApp.ViewModels"
        xmlns:models="clr-namespace:LogManagerApp.Models"
        Title="Log Manager" Height="450" Width="700">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <StackPanel>

            <!-- ФИЛЬТР -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                <!-- Тип -->
                <ComboBox Width="120" Margin="5"
                     SelectedValue="{Binding SelectedType}"
                     SelectedValuePath="Tag">

                    <ComboBoxItem Content="Все" Tag="{x:Null}"/>
                    <ComboBoxItem Content="Info" Tag="{x:Static models:LogType.Info}"/>
                    <ComboBoxItem Content="Warning" Tag="{x:Static models:LogType.Warning}"/>
                    <ComboBoxItem Content="Error" Tag="{x:Static models:LogType.Error}"/>

                </ComboBox>

                <!-- Дата ОТ -->
                <DatePicker Width="140" Margin="5"
                            SelectedDate="{Binding FromDate}"/>

                <!-- Дата ДО -->
                <DatePicker Width="140" Margin="5"
                            SelectedDate="{Binding ToDate}"/>

                <Button Content="Фильтр" Width="100" Margin="5"
                        Click="Filter_Click"/>

                <Button Content="Сброс" Width="100" Margin="5"
                        Click="Reset_Click"/>

            </StackPanel>

            <!-- СПИСОК -->
            <ListBox Height="250" ItemsSource="{Binding Messages}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- КНОПКИ -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Info" Width="100" Margin="5"
                        Click="AddInfo_Click"/>
                <Button Content="Warning" Width="100" Margin="5"
                        Click="AddWarning_Click"/>
                <Button Content="Error" Width="100" Margin="5"
                        Click="AddError_Click"/>
                <Button Content="Сохранить" Width="120" Margin="5"
                        Click="Save_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>